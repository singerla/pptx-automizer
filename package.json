{
  "name": "pptx-automizer",
  "version": "0.9.3",
  "description": "A template based pptx generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singerla/pptx-automizer.git"
  },
  "author": "Thomas Singer <tsinger@gmx.de> (github.com/singerla)",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "nodemon -e ts --exec 'ts-node' src/dev.ts",
    "test": "npx jest",
    "test-coverage": "npx jest --coverage",
    "test:visual": "npx jest --config jest.visual.config.ts",
    "docs:ai": "ts-node tools/ai-instructor/build.ts",
    "docs:api": "yarn --cwd website docusaurus generate-typedoc",
    "docs:start": "yarn --cwd website start",
    "docs:build": "yarn --cwd website build",
    "docs:serve": "yarn --cwd website serve",
    "validate:pptx": "docker build -q -t pptx-validator tools/validate-pptx && docker run --rm -v \"$PWD:/repo:ro\" pptx-validator --allowlist /repo/tools/validate-pptx/allowlist.json /repo/__tests__/pptx-templates /repo/__tests__/pptx-output",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write"
  },
  "files": [
    "dist",
    "AI-INSTRUCTOR.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "js-create-powerpoint",
    "js-create-pptx",
    "js-generate-powerpoint",
    "js-pptx",
    "js-produce-powerpoint",
    "js-powerpoint",
    "powerpoint",
    "powerpoint-charts",
    "powerpoint-presentation",
    "powerpoint-automation",
    "powerpoint-generator",
    "powerpoint-templates",
    "pptxgenjs-templates",
    "pptx",
    "presentations"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "pptx-thumbnailer": "0.1.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "regexp.escape": "^2.0.1",
    "slugify": "^1.6.9"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "image-size": "^2.0.2"
  }
}
